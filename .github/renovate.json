{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>brave/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "t3sts/",
    "assets/opengrep_rules/"
  ],
  "packageRules": [
    {
      "description": "tensorflow (modelscan group) ships no cp314 wheels yet; block python >=3.14 until it does",
      "matchDatasources": ["python"],
      "allowedVersions": "<3.14"
    }
  ]
}
